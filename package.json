{
  "name": "dsh-theme-orbit",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "author": "ZcNCn39",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZcNCn39/dsh-theme-orbit.git"
  },
  "homepage": "https://github.com/ZcNCn39/dsh-theme-orbit#readme",
  "bugs": "https://github.com/ZcNCn39/dsh-theme-orbit/issues",
  "keywords": ["deepseek", "dsh", "theme", "space", "moon"],
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "description": "Orbit (轨道) — a space theme for DeepSeek Harness: deep-space surfaces over an injected starfield, starlight-blue accent, and a moon-dust light palette. Ships as a --dsw-* token layer plus one scoped stylesheet.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
